{
  "name": "@aoagents/ao-workflow",
  "version": "0.0.1",
  "description": "Workflow engine extension for agent-orchestrator (aow CLI)",
  "license": "MIT",
  "type": "module",
  "bin": {
    "aow": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ComposioHQ/agent-orchestrator.git",
    "directory": "packages/workflow"
  },
  "homepage": "https://github.com/ComposioHQ/agent-orchestrator",
  "bugs": {
    "url": "https://github.com/ComposioHQ/agent-orchestrator/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aoagents/ao-core": "workspace:*",
    "chalk": "^5.4.0",
    "commander": "^13.0.0",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
